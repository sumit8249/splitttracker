# Copy this file to secrets.toml and replace the placeholders.
# Never commit the real secrets.toml file.

GEMINI_API_KEY = "your-gemini-api-key"

# Gmail: enable 2-Step Verification, then create a 16-character App Password.
# Do not use your normal Gmail password here.
GMAIL_ADDRESS = "you@gmail.com"
GMAIL_APP_PASSWORD = "your-16-character-app-password"